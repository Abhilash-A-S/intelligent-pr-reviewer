# Configure one or both source-control providers. Never commit real tokens.
GITHUB_TOKEN=
AZURE_DEVOPS_PAT=

# Local semantic-review model
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_READ_TIMEOUT=300

# Optional web runtime settings
PR_REVIEW_API_HOST=127.0.0.1
PR_REVIEW_API_PORT=8000
PR_REVIEW_MAX_JOBS=1
PR_REVIEW_UI_FILE_COUNT_LIMIT=30
PR_REVIEW_UI_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional Azure defaults used for connection validation and short repository names
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=

# Required for the shared web application. No authentication bypass is provided.
# Register a confidential Web application in a single Microsoft Entra tenant.
PR_REVIEW_ENTRA_TENANT_ID=
PR_REVIEW_OIDC_CLIENT_ID=
PR_REVIEW_OIDC_CLIENT_SECRET=
# Alternatively set an exact HTTPS OpenID Connect issuer (RS256 support required).
PR_REVIEW_OIDC_ISSUER=
PR_REVIEW_SIGN_IN_LABEL=Microsoft
# HTTPS is required except for localhost / 127.0.0.1 development.
PR_REVIEW_PUBLIC_URL=http://127.0.0.1:8000
PR_REVIEW_ACCESS_POLICY=access-policy.json
PR_REVIEW_AUTH_DB=data/auth.sqlite3
