# Ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_READ_TIMEOUT=300

# Web application
PR_REVIEW_API_HOST=127.0.0.1
PR_REVIEW_API_PORT=8000
PR_REVIEW_MAX_JOBS=1
PR_REVIEW_UI_FILE_COUNT_LIMIT=30
PR_REVIEW_UI_ORIGINS=http://localhost:4200,http://127.0.0.1:4200


# Organizational web sign-in. Never commit real secret values.
PR_REVIEW_PUBLIC_URL=http://localhost:8000
PR_REVIEW_AUTH_DB=data/auth.sqlite3
PR_REVIEW_ACCESS_MODE=provider
PR_REVIEW_CONNECTION_KEY=

# Register a confidential Web application in a single Microsoft Entra tenant.
PR_REVIEW_ENTRA_TENANT_ID=
PR_REVIEW_OIDC_CLIENT_ID=
PR_REVIEW_OIDC_CLIENT_SECRET=

# GitHub OAuth application, approved by the company organization as required.
PR_REVIEW_GITHUB_CLIENT_ID=
PR_REVIEW_GITHUB_CLIENT_SECRET=


# Login buttons: azure-devops only, github only, or both (comma-separated).
PR_REVIEW_ENABLED_PROVIDERS=github,azure-devops